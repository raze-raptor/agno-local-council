# Copy to /etc/agno/agno.env (root:agno 0640). Contains NO secrets: LM Studio needs none.
AGNO_TELEMETRY=false
AGNO_BACKGROUND_MAX_CONCURRENCY=1
AGNO_STATE_DIR=/var/lib/agno
AGNO_BIND=127.0.0.1
AGNO_PORT=7777
# Where the model server answers. In the reference setup this is an SSH tunnel to LM Studio on a GPU PC.
LMSTUDIO_BASE_URL=http://127.0.0.1:11235/v1
LMSTUDIO_MODEL=mellum2.1-12b-a2.5b-thinking
LMSTUDIO_CONTEXT=16384
PYTHONDONTWRITEBYTECODE=1
# The unattended-work window in app/window.py is hard-wired to Europe/London; change it there too.
TZ=Europe/London
